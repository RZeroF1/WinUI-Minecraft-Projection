<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RZeroF1.Minecraft.Projection</AssemblyName>
    <RootNamespace>RZeroF1.Minecraft.Projection</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>RZeroF1.Minecraft.Projection</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.1.1</PackageVersion>
    <Version Condition="'$(Version)' == ''">$(PackageVersion)</Version>
    <Authors>RZeroF1</Authors>
    <Description>Windows x64 Minecraft 投影 SDK，提供投影解析、游戏资源加载、模型与网格构建、切片、相机、D3D11 渲染、PNG 截图及资源诊断。</Description>
    <PackageTags>minecraft;projection;litematic;schem;d3d11;rendering;sdk</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>P3 共享图案表面、陶罐组件、字体资源及本地外观接入生产；修正头颅逻辑画布、配方与实例外观缓存。固定生物头按机制完成 20 个精确客户端 CPU/资源验证，陶罐覆盖 14 个客户端；告示牌文字方向及布局仍未通过，完整边界见 API 文档。内部保留 Litematic/Sponge v2/v3 Block Entity，独立识别源数据与客户端 Profile；接入组合贡献计划和 Partial/未知数据诊断；新增共享部件、逻辑 UV、Sprite source 子集和限定资源端点的首批静态专用模型，保留普通模型与流体及原 Native ABI。修复楼梯等矩形面的 UV Lock 旋转拉伸；孤立玻璃板预览过滤默认开启，可显式关闭并保留原始材料统计。修复渲染占位、动画首帧、模型遮挡与旋转、薄面和基础流体；新增分组渲染诊断；限定公开包内容。新增 VirtualSurfaceImageSource GPU 输出，支持 XAML 亚克力叠加；保留 SwapChainPanel 接入，统一截图来源，补充显存估算并修正尺寸状态更新；统一中文文档并提供英文 README。</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/RZeroF1/WinUI-Minecraft-Projection</RepositoryUrl>
    <PackageProjectUrl>https://github.com/RZeroF1/WinUI-Minecraft-Projection</PackageProjectUrl>
    <PackageOutputPath>$(RepositoryRoot)artifacts\packages\</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Capabilities\vanilla-capabilities.json"
                      LogicalName="RZeroF1.Minecraft.Projection.vanilla-capabilities.json" />
    <None Update="Capabilities\vanilla-capabilities.json" Pack="false" />
    <EmbeddedResource Include="Capabilities\p2-compatibility.json"
                      LogicalName="RZeroF1.Minecraft.Projection.p2-compatibility.json" />
    <None Update="Capabilities\p2-compatibility.json" Pack="false" />
    <EmbeddedResource Include="Capabilities\p3-compatibility.json"
                      LogicalName="RZeroF1.Minecraft.Projection.p3-compatibility.json" />
    <None Update="Capabilities\p3-compatibility.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="" />
    <None Include="$(RepositoryRoot)README.en.md" Pack="true" PackagePath="" />
    <None Include="$(RepositoryRoot)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(RepositoryRoot)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="$(RepositoryRoot)docs\api.md;$(RepositoryRoot)docs\architecture.md;$(RepositoryRoot)docs\nuget.md" Pack="true" PackagePath="docs" />
    <None Include="$(RepositoryRoot)native\projection\README.md" Pack="true" PackagePath="native\projection" />
    <None Include="$(RepositoryRoot)licenses\minecraft-renderer\LICENSE;$(RepositoryRoot)licenses\minecraft-renderer\SOURCE.md" Pack="true" PackagePath="licenses/minecraft-renderer" />
    <None Include="$(RepositoryRoot)licenses\schematic-editor\LICENSE;$(RepositoryRoot)licenses\schematic-editor\SOURCE.md" Pack="true" PackagePath="licenses/schematic-editor" />
    <None Include="$(TargetDir)rzero_projection_d3d11.dll"
          Pack="true" CopyToOutputDirectory="PreserveNewest" Link="rzero_projection_d3d11.dll"
          PackagePath="runtimes\win-x64\native" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="Microsoft.WindowsAppSDK.WinUI" Version="[2.3.9]" />
  </ItemGroup>

  <PropertyGroup>
    <ProjectionWinUiInclude>$(NuGetPackageRoot)\microsoft.windowsappsdk.winui\2.3.9\include</ProjectionWinUiInclude>
  </PropertyGroup>

  <Target Name="BuildProjectionNative"
          BeforeTargets="PrepareForBuild"
          Inputs="$(RepositoryRoot)native\projection\renderer.cpp;$(RepositoryRoot)native\projection\build.cmd;$(ProjectionWinUiInclude)\microsoft.ui.xaml.media.dxinterop.h"
          Outputs="$(TargetDir)rzero_projection_d3d11.dll"
          Condition="'$(ProjectionNativeRid)' == 'win-x64'">
    <MakeDir Directories="$(TargetDir)" />
    <Exec Command="&quot;$(RepositoryRoot)native\projection\build.cmd&quot; x64 &quot;$(TargetDir)&quot; &quot;$(ProjectionWinUiInclude)&quot;" />
  </Target>

  <Target Name="RejectUnsupportedProjectionRid"
          BeforeTargets="Build"
          Condition="'$(ProjectionNativeRid)' != 'win-x64'">
    <Error Text="RZeroF1.Minecraft.Projection currently supports only win-x64; received $(ProjectionNativeRid)." />
  </Target>
</Project>
